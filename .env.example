# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather.
# Used on the server/backend for HMAC-SHA256 signature verification of Telegram Mini App launch data.
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"

# VITE_TELEGRAM_BOT_USERNAME: The official username of the ATH Telegram Bot (without @).
VITE_TELEGRAM_BOT_USERNAME="abyssiniatradingbot"

# VITE_TELEGRAM_MINI_APP_URL: The direct Telegram launch link for the ATH Mini App.
VITE_TELEGRAM_MINI_APP_URL="https://t.me/abyssiniatradingbot"
